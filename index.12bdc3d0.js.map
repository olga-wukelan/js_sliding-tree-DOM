"use strict";
var tree = document.querySelector(".tree");
var list = document.querySelectorAll(".tree li ul");
list.forEach(function(ulElm) {
    var liElm = ulElm.parentElement;
    var headerTextNode = liElm.firstChild;
    if (!headerTextNode || headerTextNode.nodeType !== 3) return;
    var createSpan = document.createElement("span");
    createSpan.textContent = headerTextNode.textContent.trim();
    createSpan.classList.add("tree-header");
    createSpan.style.cursor = "pointer";
    liElm.replaceChild(createSpan, headerTextNode);
    ulElm.hidden = true;
});
tree.addEventListener("click", function(e) {
    if (e.target.tagName !== "SPAN") return;
    var findLi = e.target.closest("li");
    var findUl = findLi.querySelector("ul");
    if (findUl) // Перемикання властивості hidden
    findUl.hidden = !findUl.hidden;
});

